{
  "name": "IntelliTalk",
  "version": "0.0.1",
  "private": true,
  "scripts": {
    "android": "react-native run-android",
    "ios": "react-native run-ios",
    "lint": "eslint .",
    "start": "react-native start",
    "test": "jest",
    "debug-build": "cd android && gradlew assembleDebug",
    "release-build": "cd android && gradlew assembleRelease",
    "build-android": "react-native build-android --mode=release",
    "clean-gradle": "cd android && gradlew clean && cd ..",
    "fresh-install": "rm -rf node_modules package-lock.json && npm install && npm run clean-gradle && npm start -- --reset-cache"
  },
